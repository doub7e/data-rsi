# Large artifacts remain on shared storage; never manage model checkpoints in Git.
**/checkpoint/
**/checkpoints/
**/checkpoint-*/
**/checkpoint_*/
**/ckpt/
**/ckpts/
**/weights/
*.safetensors
*.pt
*.pth
*.ckpt
*.bin
*.gguf
*.onnx
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pickle
*.arrow
*.parquet
*.tar
*.tar.*
*.tgz
*.zip
*.whl
*.iso
*.mp4
*.pdf

# Downloaded data, dependencies, vendored references, sandbox/build material.
**/data/
**/cache/
**/.cache/
**/dataset_cache/
**/torch_extensions/
**/.venv/
**/venv/
**/site-packages/
**/__pycache__/
**/.pytest_cache/
**/upstream/
**/reference/
**/runtime/
**/assets/
**/outputs/
**/tasks/
**/contexts/
**/builds/
**/benchmarks/
**/bin/
**/smoke/
**/monitoring/
**/inputs/
*.pyc
*.pyo

# Run trees: keep only small, reviewable manifests and final summaries by default.
**/runs/*/*
!**/runs/*/run.json
!**/runs/*/result.json
!**/runs/*/summary.json
!**/runs/*/comparison.json
!**/runs/*/REPORT.md
!**/runs/*/README.md
!**/runs/*/train.yaml
!**/runs/*/data-encoding-audit.json
!**/runs/*/per-task.csv
!**/runs/*/comparison.png
!**/runs/*/sampling.png
!**/runs/*/training-curves.png

# Live control/status files and local process output.
*.log
*.lock
*.pid
*.tmp
*.tmp-*
**/tracking/
**/dispatch-status.json
**/supervisor-status*.json
**/supervisor-process*.json
**/coordinator-current.json
**/dispatch-plan.json
**/supervisor-stopped.json

# Credentials and machine-local auth state. Scripts referencing secrets may be tracked.
**/.env
**/.env.*
!**/.env.example
**/.secrets/
**/secrets/
**/docker-config/
**/.docker/
**/.kube/
**/.aws/
**/.ssh/
**/kubeconfig
**/*kubeconfig*.json
**/*kubeconfig*.yaml
**/*kubeconfig*.yml
**/auth.json
**/credentials.json
**/credentials.yaml
**/credentials.yml
**/registry-auth*
*.pem
*.key

# Locally generated publication/audit details.
.git-publish/
*.jsonl
*.gz
*.zst
*.xz
*.sqlite
*.sqlite3
*.db
*.log.*
.nfs*

# Generated runtime copies from other projects; retain their provenance metadata.
/qwen_math_*/controller*/source/
/qwen_math_*/extension-source/source/
/qwen_math_*/revisions/**/source/
